# Local .terraform directories
**/.terraform/*

# .tfstate files (state lives in GCS backend, not locally)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# .tfvars often contain sensitive data
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan output
*tfplan*

# CLI configuration files
.terraformrc
terraform.rc

# Local backend config (contains bucket/prefix; CI reads from repo variables)
backend.hcl

# macOS
.DS_Store
